{
  "name": "matri-service",
  "version": "1.0.0",
  "description": "Matri collaboration backend service for team management and real-time collaboration",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node start-dev.js",
    "dev:watch": "nodemon start-dev.js",
    "dev:simple": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup": "node start-dev.js --setup-only",
    "check-redis": "node check-redis.js",
    "check-database": "node check-database.js",
    "check-all": "node check-database.js && node check-redis.js",
    "fix-errors": "node fix-errors.js",
    "health-check": "node health-check.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.0-rc.3",
    "nodemailer": "^6.10.0",
    "shared-utils": "file:../shared-utils",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.1",
    "uuid": "^9.0.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "eslint": "^8.23.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "matri",
    "collaboration",
    "teams",
    "real-time",
    "api",
    "microservice"
  ],
  "author": "Synchubb Team",
  "license": "ISC"
}
