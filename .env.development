# Development Environment Configuration
# Copy this to .env for local development

# Server Configuration
PORT=3003
NODE_ENV=development
API_VERSION=v1

# Database Configuration (Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/matri-service
MONGODB_TEST_URI=mongodb://localhost:27017/matri-service-test

# Redis Configuration (Local Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=development-jwt-secret-key-not-for-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=development-refresh-secret-key-not-for-production
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (for invitations) - Use production values or setup local SMTP
EMAIL_HOST=gmail
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# External Service URLs
AUTH_SERVICE_URL=http://localhost:8000
MEDIA_API_URL=http://localhost:3001
WEBSOCKET_SERVICE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173
MATRI_FRONTEND_URL=http://localhost:5175

# Cloudinary Configuration (Use production values or setup local storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# File Upload Limits
MAX_FILE_SIZE=50MB
MAX_FILES_PER_REQUEST=10

# WebRTC Configuration
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVERS=

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=logs/matri-service.log
